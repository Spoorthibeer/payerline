{
  "name": "payerline",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"tsx watch server/index.ts\" \"npm run dev --prefix payer-line-product-template -- --port 5173\"",
    "seed": "tsx scripts/seed.ts",
    "verify-memory": "tsx scripts/verify-memory.ts",
    "build": "npm run build --prefix payer-line-product-template",
    "start": "tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@vectorize-io/hindsight-client": "^0.10.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
